<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/helpRequestContainer"
    android:layout_width="@dimen/input_panel_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bubble_background"
    android:padding="@dimen/bubble_padding"
    android:elevation="12dp">

    <TextView
        android:id="@+id/tvHelpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/how_can_i_help"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/taptrail_on_surface"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quick_suggestions"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/taptrail_on_surface_secondary"
        android:letterSpacing="0.04"
        android:layout_marginBottom="6dp" />

    <!-- Suggestion Chips Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipHotspot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Hotspot"
                android:textSize="12sp"
                android:textColor="@color/taptrail_on_surface"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipDarkTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 Dark Theme"
                android:textSize="12sp"
                android:textColor="@color/taptrail_on_surface"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipBatterySaver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 Battery Saver"
                android:textSize="12sp"
                android:textColor="@color/taptrail_on_surface"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Search Web"
                android:textSize="12sp"
                android:textColor="@color/taptrail_on_surface"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 Message"
                android:textSize="12sp"
                android:textColor="@color/taptrail_on_surface"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Camera"
                android:textSize="12sp"
                android:textColor="@color/taptrail_on_surface"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipBluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎧 Bluetooth"
                android:textSize="12sp"
                android:textColor="@color/taptrail_on_surface"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#EDF2F7"
        android:paddingEnd="4dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etUserRequest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_enter_request"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@android:color/transparent"
            android:textColor="@color/taptrail_on_surface"
            android:textColorHint="@color/taptrail_on_surface_secondary"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:gravity="top|start" />

        <ImageButton
            android:id="@+id/btnVoiceInput"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_mic"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Command"
            android:scaleType="centerInside" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/cancel"
            android:textColor="@color/taptrail_on_surface_secondary"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/ask"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/taptrail_primary" />
    </LinearLayout>

</LinearLayout>
